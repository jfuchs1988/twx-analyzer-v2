<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.twxav2</groupId>
  <artifactId>twxav2</artifactId>
  <version>1.0.0-SNAPSHOT</version>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>25</maven.compiler.release>
    <quarkus.platform.group-id>io.quarkus.platform</quarkus.platform.group-id>
    <quarkus.platform.artifact-id>quarkus-bom</quarkus.platform.artifact-id>
    <quarkus.platform.version>3.40.1.1</quarkus.platform.version>
    <compiler-plugin.version>3.16.0</compiler-plugin.version>
    <!-- Minimum line-coverage gate for JaCoCo-instrumented code. Quarkus test
         classloader limitations are documented with the JaCoCo plugin below;
         this value is not a measure of total runtime/API coverage. -->
    <jacoco.min.line.ratio>0.64</jacoco.min.line.ratio>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>${quarkus.platform.group-id}</groupId>
        <artifactId>${quarkus.platform.artifact-id}</artifactId>
        <version>${quarkus.platform.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-rest</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-rest-jackson</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-hibernate-orm-panache</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-jdbc-mariadb</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-smallrye-openapi</artifactId>
    </dependency>
    <dependency>
      <!-- JavaScript syntax parser only (does not execute code); used by R-JS rules. -->
      <groupId>org.mozilla</groupId>
      <artifactId>rhino</artifactId>
      <version>1.9.1</version>
    </dependency>

    <!-- JUnit tests -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-junit</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- In-memory database for @QuarkusTest (API/service Panache layer). -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-jdbc-h2</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>${quarkus.platform.group-id}</groupId>
        <artifactId>quarkus-maven-plugin</artifactId>
        <version>${quarkus.platform.version}</version>
        <extensions>true</extensions>
        <executions>
          <execution>
            <goals>
              <goal>build</goal>
              <goal>generate-code</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>${compiler-plugin.version}</version>
      </plugin>
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.6.1</version>
        <configuration>
          <!-- Set JBoss LogManager early; otherwise a warning and a hanging fork shutdown may occur. -->
          <argLine>@{argLine} -Djava.util.logging.manager=org.jboss.logmanager.LogManager</argLine>
          <!-- The JaCoCo dump can take over 30 seconds on a slow bind mount. The
               30-second default can kill the fork during the write and omit
               Quarkus classes from the report. This adds about one minute but
               avoids losing coverage data. -->
          <forkedProcessExitTimeoutInSeconds>180</forkedProcessExitTimeoutInSeconds>
        </configuration>
      </plugin>
      <!-- Coverage: generate a report on every `mvn test`; the check enforces
           the minimum line coverage. It intentionally runs in the test phase
           (after report, before quarkus:build), because Quarkus augments classes
           during package and would distort the measurement. The target is 1.00;
           raise the threshold incrementally as test coverage grows.
           Measurement limitation (verified 2026-10): classes defined by the
           QuarkusClassLoader in the @QuarkusTest runtime bypass JaCoCo's
           ClassFileTransformer. The agent therefore never sees probe arrays for
           them (a probe test initialized SnapshotResource/IngestService/model.Snapshot
           during Quarkus startup; the exec file contained no entries). The report
           measures only the app-classloader path, although HTTP tests still provide
           functional coverage (including catching the toolkit-conflicts NPE).
           Offline instrumentation (jacoco:instrument) conflicts with the agent
           due to duplicate probes; @QuarkusIntegrationTest would require a second
           container-based test path. -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>0.8.16</version>
        <executions>
          <execution>
            <id>prepare-agent</id>
            <goals><goal>prepare-agent</goal></goals>
          </execution>
          <execution>
            <id>report</id>
            <phase>test</phase>
            <goals><goal>report</goal></goals>
          </execution>
          <execution>
            <id>coverage-check</id>
            <phase>test</phase>
            <goals><goal>check</goal></goals>
            <configuration>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>${jacoco.min.line.ratio}</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

</project>
